# --- Halcyon ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# builds
build/
dist/
*.spec
*.build/
*.dist/
*.onefile-build/

# bundled libVLC binaries (see README — fetched, never committed)
vendor/vlc/

# WebView2 SDK bridge files — fetched locally, never committed (see README / §P3.2)
vendor/webview2/

# compiled shaders are generated from .frag sources
*.qsb

# runtime / local
.halcyon-appdata/
*.log
.DS_Store
Thumbs.db
.idea/

# Editor settings stay local, but the debug launch configuration is shared:
# it is how you get QML warnings into the console (see README → Debugging).
.vscode/*
!.vscode/launch.json
